<h1>
Movie #<%= @the_movie.id %> details
</h1>

<a href="/movies">Go back</a>

<hr>

<dl>
  <dt>Title</dt>
  <dd><%= @the_movie.title %></dd>

  <dt>Year</dt>
  <dd><%= @the_movie.year%></dd>

  <dt>Duration</dt>
  <dd><%= @the_movie.duration %></dd>

<dt>Description</dt>
  <dd><%= @the_movie.description %></dd>

  <dt>Image</dt>
  <dd><image src ="<%= @the_movie.image %>" width = "200"</dd>


</dl>
